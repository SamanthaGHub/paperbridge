<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>午夜来电</title>

<style>
*{box-sizing:border-box}

body{
  margin:0;
  min-height:100vh;
  background:#050505;
  color:#ddd;
  font-family:"Microsoft YaHei",sans-serif;
  display:flex;
  justify-content:center;
  align-items:center;
  overflow:hidden;
}

#game{
  width:min(700px,94vw);
  min-height:600px;
  padding:35px 25px;
  background:
    radial-gradient(circle at center,#171717,#030303 75%);
  border:1px solid #333;
  box-shadow:0 0 60px #000;
  text-align:center;
  position:relative;
}

h1{
  font-size:42px;
  letter-spacing:10px;
  color:#eee;
  text-shadow:0 0 15px #777;
}

.sub{
  color:#777;
  letter-spacing:3px;
}

#time{
  font-size:55px;
  margin:35px 0;
  color:#bcbcbc;
  text-shadow:0 0 15px #fff;
}

#phone{
  margin:auto;
  width:220px;
  height:300px;
  background:#111;
  border:4px solid #292929;
  border-radius:28px;
  box-shadow:0 0 30px #000;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
}

.phoneIcon{
  font-size:65px;
  animation:ring .7s infinite;
}

@keyframes ring{
  0%{transform:rotate(0)}
  25%{transform:rotate(-12deg)}
  50%{transform:rotate(12deg)}
  75%{transform:rotate(-8deg)}
  100%{transform:rotate(0)}
}

#caller{
  margin-top:20px;
  color:#aaa;
  font-size:14px;
}

button{
  margin:8px;
  padding:13px 28px;
  background:#111;
  color:#ddd;
  border:1px solid #555;
  border-radius:5px;
  cursor:pointer;
  font-size:15px;
}

button:hover{
  background:#300909;
  border-color:#a33;
  color:#fff;
}

#story{
  min-height:100px;
  margin:25px auto;
  max-width:520px;
  line-height:2;
  color:#aaa;
}

.red{
  color:#b22;
}

.hidden{
  display:none;
}

.shake{
  animation:shake .15s 5;
}

@keyframes shake{
  25%{transform:translateX(-8px)}
  75%{transform:translateX(8px)}
}

#blood{
  position:fixed;
  top:-20px;
  font-size:15px;
  pointer-events:none;
  z-index:999;
  animation:fall 4s linear forwards;
}

@keyframes fall{
  to{
    transform:translateY(110vh);
    opacity:0;
  }
}
</style>
</head>

<body>

<div id="game">

  <div class="sub">午夜 00:00</div>

  <h1>午夜来电</h1>

  <div id="time">00:00</div>

  <div id="phone">
    <div class="phoneIcon">📞</div>
    <div id="caller">未知来电</div>
  </div>

  <div id="story">
    房间里很安静。<br>
    只有墙上的时钟正在走动。
  </div>

  <div id="buttons">
    <button onclick="startGame()">等待午夜</button>
  </div>

</div>

<script>

let step=0;
let ringing=false;

const story=document.getElementById("story");
const buttons=document.getElementById("buttons");
const phone=document.getElementById("phone");
const time=document.getElementById("time");

function startGame(){

  step=1;

  buttons.innerHTML=
  '<button onclick="answer()">接听电话</button>'+
  '<button onclick="hangup()">挂断</button>'+
  '<button onclick="silent()">静音</button>';

  story.innerHTML=
  '墙上的时钟突然停了。<br>'+
  '<span class="red">00:00</span><br>'+
  '电话响了。';

  ring();

}

function ring(){

  ringing=true;

  phone.classList.add("shake");

  setTimeout(()=>{
    phone.classList.remove("shake");
  },800);

}

function answer(){

  step=2;

  story.innerHTML=
  '你接起电话。<br><br>'+
  '电话那头没有声音。<br>'+
  '只有一个女人在呼吸。';

  buttons.innerHTML=
  '<button onclick="speak()">说话</button>'+
  '<button onclick="listen()">继续听</button>';

}

function speak(){

  story.innerHTML=
  '<span class="red">你：</span>“喂？”<br><br>'+
  '电话那头沉默了几秒。<br>'+
  '然后，一个声音问：<br><br>'+
  '<b>“你为什么还没有睡？”</b>';

  buttons.innerHTML=
  '<button onclick="truth()">回答“我睡不着”</button>'+
  '<button onclick="ask()">问她是谁</button>';

}

function listen(){

  story.innerHTML=
  '你没有说话。<br><br>'+
  '电话那头突然传来脚步声。<br>'+
  '一步。<br>'+
  '两步。<br>'+
  '三步。';

  buttons.innerHTML=
  '<button onclick="listen2()">继续听</button>';

}

function listen2(){

  story.innerHTML=
  '<span class="red">脚步声停在了你的房门外。</span><br><br>'+
  '可是……<br>'+
  '电话里的声音还在继续呼吸。';

  buttons.innerHTML=
  '<button onclick="badEnd()">查看门外</button>'+
  '<button onclick="stay()">留在原地</button>';

}

function ask(){

  story.innerHTML=
  '你问：“你是谁？”<br><br>'+
  '电话那头传来一阵笑声。<br>'+
  '然后她说：<br><br>'+
  '<b>“你真的不记得我了吗？”</b>';

  buttons.innerHTML=
  '<button onclick="lookPhone()">看手机</button>';

}

function lookPhone(){

  phone.classList.add("shake");

  story.innerHTML=
  '<span class="red">你的手机屏幕突然亮了。</span><br><br>'+
  '来电号码不是陌生号码。<br>'+
  '而是——<br><br>'+
  '<b>你的电话号码。</b>';

  buttons.innerHTML=
  '<button onclick="trueEnd()">继续接听</button>';

}

function truth(){

  story.innerHTML=
  '电话那头突然安静下来。<br><br>'+
  '随后，她轻声说道：<br><br>'+
  '<b>“可是……我就在你身后。”</b>';

  setTimeout(()=>{
    trueEnd();
  },2500);

}

function silent(){

  story.innerHTML=
  '你按下静音。<br><br>'+
  '电话没有挂断。<br>'+
  '屏幕上却出现了一行字：<br><br>'+
  '<span class="red">“别出声。”</span>';

  buttons.innerHTML=
  '<button onclick="silent2()">为什么？</button>';

}

function silent2(){

  story.innerHTML=
  '你刚准备输入文字。<br><br>'+
  '手机自动发送了一条消息：<br><br>'+
  '<b>“我知道你在房间里。”</b>';

  buttons.innerHTML=
  '<button onclick="badEnd()">关掉手机</button>';

}

function hangup(){

  story.innerHTML=
  '你挂断了电话。<br><br>'+
  '房间恢复了安静。';

  buttons.innerHTML=
  '<button onclick="turn()">回头看看</button>';

}

function turn(){

  story.innerHTML=
  '<span class="red">你身后的手机响了。</span><br><br>'+
  '可是……<br>'+
  '你的手机明明就在手里。';

  phone.classList.add("shake");

  buttons.innerHTML=
  '<button onclick="badEnd()">回头</button>'+
  '<button onclick="stay()">不回头</button>';

}

function stay(){

  story.innerHTML=
  '你没有回头。<br><br>'+
  '几秒后，手机停止了响铃。<br>'+
  '天亮了。';

  buttons.innerHTML=
  '<button onclick="location.reload()">重新开始</button>';

}

function badEnd(){

  document.body.classList.add("shake");

  story.innerHTML=
  '<span class="red"><b>坏结局</b></span><br><br>'+
  '你打开了门。<br><br>'+
  '门外没有任何人。<br>'+
  '只有一部正在响铃的旧手机。<br><br>'+
  '屏幕上显示：<br>'+
  '<b>正在拨打你的号码……</b>';

  buttons.innerHTML=
  '<button onclick="location.reload()">重新开始</button>';

  blood();

}

function trueEnd(){

  story.innerHTML=
  '<span class="red"><b>真相结局</b></span><br><br>'+
  '你终于想起来了。<br><br>'+
  '七年前的那场事故里，<br>'+
  '真正接到午夜电话的人……<br>'+
  '一直都是你。';

  buttons.innerHTML=
  '<button onclick="location.reload()">重新开始</button>';

  blood();

}

function ring(){

  if(navigator.vibrate){
    navigator.vibrate([300,100,300]);
  }

}

function blood(){

  for(let i=0;i<12;i++){

    setTimeout(()=>{

      let b=document.createElement("div");

      b.id="blood";
      b.innerHTML="🩸";

      b.style.left=Math.random()*100+"vw";

      b.style.fontSize=(8+Math.random()*10)+"px";

      document.body.appendChild(b);

      setTimeout(()=>b.remove(),4000);

    },i*150);

  }

}

</script>

</body>
</html>
